<Window x:Class="View.AlquileresView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:View"
        mc:Ignorable="d"
        Title="Gestión de Préstamos - VideoClub" 
        Height="680" Width="1200"
        WindowStartupLocation="CenterScreen">

    <Window.Background>
        <LinearGradientBrush StartPoint="0,1" EndPoint="0,0">
            <GradientStop Color="#E3FFCC" Offset="0"/>
            <GradientStop Color="#FFFFFF" Offset="1"/>
        </LinearGradientBrush>
    </Window.Background>

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Estilos.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="55"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Style="{StaticResource BarraSup}" Grid.Row="0">
            <DockPanel>
                <TextBlock Text="Registro de Alquileres y Devoluciones" Style="{StaticResource TituloBarraStyle}" DockPanel.Dock="Left"/>
            </DockPanel>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource TarjetaStyle}" Margin="0,20,0,10">
            <StackPanel>
                <TextBlock Text="Nuevo Alquiler" Style="{StaticResource TituloTarjetaStyle}"/>

                <UniformGrid Columns="3">
                    <StackPanel Margin="20,0">
                        <TextBlock Text="Seleccionar Cliente" Style="{StaticResource LabelStyle}"/>
                        <ComboBox ItemsSource="{Binding ListaClientes}" 
                                  SelectedItem="{Binding ClienteSeleccionado}"
                                  DisplayMemberPath="Nombre"
                                  Style="{StaticResource ComboBoxStyle}"/>
                        <TextBlock Text="{Binding ErrorCliente}" Style="{StaticResource ErrorMensajeStyle}"/>
                    </StackPanel>

                    <StackPanel Margin="20,0">
                        <TextBlock Text="Seleccionar Producto" Style="{StaticResource LabelStyle}"/>
                        <ComboBox ItemsSource="{Binding ListaProductosDisponibles}" 
                                  SelectedItem="{Binding ProductoSeleccionado}"
                                  DisplayMemberPath="Titulo"
                                  Style="{StaticResource ComboBoxStyle}"/>
                        <TextBlock Text="{Binding ErrorProducto}" Style="{StaticResource ErrorMensajeStyle}"/>
                    </StackPanel>

                    <StackPanel Margin="0,0" Width="250">
                        <TextBlock Text="Fecha Devolución Prevista" Style="{StaticResource LabelStyle}"/>
                        <DatePicker SelectedDate="{Binding FechaDevolucionPrevista}" 
                                    Style="{StaticResource DatePickerStyle}"/>
                        <TextBlock Text="{Binding ErrorFecha}" Style="{StaticResource ErrorMensajeStyle}"/>
                    </StackPanel>
                </UniformGrid>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,10,0">
                    <Button Content="Limpiar Formulario" Command="{Binding LimpiarCommand}" Style="{StaticResource LimpiarButtonStyle}" Width="150" Margin="5"/>
                    <Button Content="Confirmar Alquiler" Command="{Binding AlquilarCommand}" Style="{StaticResource PrimaryButtonStyle}" Width="180" Margin="5"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource ListaStyle}" Margin="0,10,0,0">
            <Grid Margin="15">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Text="Historial de Alquileres" Style="{StaticResource TituloTarjetaStyle}" Grid.Row="0"/>

                <DataGrid Grid.Row="1" ItemsSource="{Binding Alquileres}" 
                          SelectedItem="{Binding AlquilerSeleccionado}" 
                          Style="{StaticResource DataGridStyle}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Cliente" Binding="{Binding Clientes.Nombre}" Width="250"/>
                        <DataGridTextColumn Header="Producto" Binding="{Binding Productos.Titulo}" Width="250"/>
                        <DataGridTextColumn Header="F. Salida" Binding="{Binding FechaSalida, StringFormat=\{0:dd/MM/yyyy\}}" Width="*"/>
                        <DataGridTextColumn Header="F. Prevista" Binding="{Binding FechaPrevistaDevolucion, StringFormat=\{0:dd/MM/yyyy\}}" Width="*"/>
                        <DataGridTextColumn Header="F. Devolución Real" Binding="{Binding FechaDevolucionReal, StringFormat=\{0:dd/MM/yyyy\}}" Width="*"/>
                        <DataGridTextColumn Header="Total" Binding="{Binding CosteTotal, StringFormat={}{0:N2} €}" Width="*"/>

                    </DataGrid.Columns>
                </DataGrid>

                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
                    <Button Content="Eliminar Alquiler" Command="{Binding EliminarCommand}" Style="{StaticResource ErrorButtonStyle}" Width="180" Margin="5"/>
                    <Button Content="Marcar como Devuelto" Command="{Binding DevolverCommand}" Style="{StaticResource PrimaryButtonStyle}" Width="200" Margin="5"/>
                    <Button Content="Generar Informe" Command="{Binding GenerarInformeCommand}" Style="{StaticResource PrimaryButtonStyle}" Width="200" Margin="5"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>